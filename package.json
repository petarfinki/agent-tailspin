{
  "name": "agent-tailspin",
  "version": "0.0.0",
  "description": "Flight recorder for Claude Code sessions: find retry loops, redundant reads, and context-bloating tool outputs. Fully local.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agent-tailspin": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "eval": "tsx eval/run.ts",
    "fixtures": "tsx scripts/gen-fixtures.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
